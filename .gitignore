# segredos — nunca versionar
.env

# exports da Hubla com dado pessoal (só o agregado em debrief.json é versionado)
clientes/*/entrada/

# gerado a cada execução (o Actions regenera)
clientes/*/out/
clientes/*/dashboard-completo.html
public/

# config local do editor
.claude/

# exports de vendas (Hotmart etc.) trazem nome, e-mail, telefone e CPF do comprador — repositório público.
# Só o JSON gerado pelo importar-hotmart.js (sem dado pessoal) entra no git.
clientes/*/vendas/*.xls
clientes/*/vendas/*.xlsx
clientes/*/vendas/*.csv
